# ==============================================================================
# PROOF OF SKILL — PRODUCTION ENVIRONMENT VARIABLE SPECIFICATION
# Target Platform: Vercel (Edge CDN + Serverless Functions)
# Source Control: GitHub
# ==============================================================================
#
# IMPORTANT SECURITY DIRECTIVES:
# 1. NEVER commit real secrets or credentials to source control.
# 2. Variables containing private keys, API secrets, or service keys MUST NEVER
#    be prefixed with NEXT_PUBLIC_ or VITE_ (doing so leaks them into browser bundles).
# 3. In Vercel, set these in Project Settings -> Environment Variables.
#
# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------

# Application public root URL (used for canonical verification links & QR codes)
# - Local: http://localhost:3000
# - Preview: https://<project-name>-git-<branch>.vercel.app
# - Production: https://proofofskill.vercel.app (or custom domain)
APP_URL="http://localhost:3000"

# Local Server Port (Used exclusively for local development; ignored by Vercel serverless)
PORT=3000

# Node Environment: "development" | "production" | "test"
# Note: Vercel sets NODE_ENV=production automatically during deployment builds.
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. AI INTEGRATION (GOOGLE GEMINI) — SERVER-SIDE ONLY
# ------------------------------------------------------------------------------
# Google Gemini 3.8 Flash is used for dynamic coding challenge generation,
# context-aware defense questioning, and rubric-based architectural evaluation.
# If omitted during local development, the platform automatically activates certified
# fallback challenge templates and local scoring matrices.
# Required for production deployments.
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 3. ISOLATED CODE EXECUTION (JUDGE0 CE) — SERVER-SIDE ONLY
# ------------------------------------------------------------------------------
# Isolated multi-tenant execution cluster for untrusted candidate code evaluation.
# If omitted during local development, a local isolated Python subprocess is used.
# For production deployments on Vercel, a remote Judge0 instance is mandatory
# because Vercel serverless containers do not bundle arbitrary Python runtimes.
# Obtain from: https://rapidapi.com/judge0-official/api/judge0-ce or self-host.
JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
JUDGE0_API_KEY=""
JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"

# ------------------------------------------------------------------------------
# 4. CRYPTOGRAPHIC CREDENTIAL AUTHORITY (ED25519) — SERVER-SIDE ONLY
# ------------------------------------------------------------------------------
# Proof of Skill signs all verified candidate credentials with an Ed25519 private key.
# The public key is exposed publicly via /api/crypto/public-key for independent verification.
#
# If omitted during local development, the server generates an ephemeral in-memory
# keypair on boot. For production, persistent keys MUST be configured.
#
# Key Generation Command (Node.js):
#   node -e "const crypto = require('crypto'); const { publicKey, privateKey } = crypto.generateKeyPairSync('ed25519', { publicKeyEncoding: { type: 'spki', format: 'pem' }, privateKeyEncoding: { type: 'pkcs8', format: 'pem' } }); console.log('\n--- ED25519_PUBLIC_KEY ---\n' + JSON.stringify(publicKey) + '\n\n--- ED25519_PRIVATE_KEY ---\n' + JSON.stringify(privateKey));"
#
# Formatting note: In .env files or Vercel Environment Variables, escape newlines
# as \n or enclose multi-line PEM strings within quotes. The crypto normalizer handles both.
ED25519_PRIVATE_KEY=""
ED25519_PUBLIC_KEY=""
PUBLIC_KEY_VERSION="v1-ed25519"

# ------------------------------------------------------------------------------
# 5. DATABASE & AUTHENTICATION (SUPABASE) — OPTIONAL / PRODUCTION ENHANCEMENT
# ------------------------------------------------------------------------------
# By default, Proof of Skill includes an in-memory & persistent ACID JSON store
# (/data/proof_of_skill_db.json locally, with /tmp fallback in serverless).
# To enable production PostgreSQL and Supabase Auth with Row Level Security:
# Schema migration script: /supabase/migrations/20261031000000_proof_of_skill_schema.sql
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ==============================================================================
# ENVIRONMENT MATRIX SUMMARY:
#
# Variable                 | Local Dev     | Vercel Preview | Vercel Production
# -------------------------|---------------|----------------|------------------
# APP_URL                  | localhost:3000| auto preview   | custom domain
# GEMINI_API_KEY           | optional      | recommended    | REQUIRED
# JUDGE0_API_KEY           | optional      | optional       | REQUIRED
# ED25519_PRIVATE_KEY      | optional      | optional       | REQUIRED
# ED25519_PUBLIC_KEY       | optional      | optional       | REQUIRED
# SUPABASE_URL             | optional      | optional       | optional
# ==============================================================================
