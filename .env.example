# ==========================================
# PROOF OF SKILL - ENVIRONMENT CONFIGURATION
# ==========================================

# AI Integration (Google Gemini API)
# Used for server-side coding challenge generation, dynamic defense questioning, and rubric scoring.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Application URL
# Used for generating canonical verification links and QR codes.
APP_URL="http://localhost:3000"

# Isolated Code Execution (Judge0 API)
# Optional for local development; if omitted, the server uses a sandboxed execution adapter.
# For production, obtain an API key from RapidAPI or host your own Judge0 CE instance.
JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
JUDGE0_API_KEY=""
JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"

# Supabase Database & Auth (Optional - Local persistent store is active by default)
# When provided, PostgreSQL and Supabase Auth are used.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Cryptographic Digital Signatures (Ed25519)
# If omitted, the server will auto-generate an ephemeral or persistent Ed25519 keypair on boot.
# To generate persistent keys: run `node -e "const crypto = require('crypto'); const { publicKey, privateKey } = crypto.generateKeyPairSync('ed25519'); console.log('PUB:', publicKey.export({type:'spki',format:'pem'})); console.log('PRIV:', privateKey.export({type:'pkcs8',format:'pem'}));"`
ED25519_PRIVATE_KEY=""
ED25519_PUBLIC_KEY=""
PUBLIC_KEY_VERSION="v1-ed25519"

# Server Port
PORT=3000
